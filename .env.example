# Server-side secrets — never commit real values.
# Copy this file to .env for local development, or set these as deployment
# secrets / environment variables on your host.

# Required for live conversation, ASR, observations and informant reports.
# Without it the app runs in a clearly labelled local demo mode.
DEEPSEEK_API_KEY=

# Optional: override the chat model (default: deepseek-flash).
DEEPSEEK_MODEL=

# Optional: semantic scope guard via NVIDIA NIM (build.nvidia.com).
# ~40 rpm / ~10k req/day free tier. Without a key the app still blocks
# code/injection patterns deterministically and fails open on
# ambiguous messages.
NVIDIA_API_KEY=
# Optional: point the guard at another OpenAI-compatible endpoint
# (overrides NVIDIA defaults).
GUARD_API_KEY=
GUARD_BASE_URL=
GUARD_MODEL=

# Optional: cost protection (see modules/rate_limit.py).
# Max DeepSeek calls per session-token per minute.
DYADLINK_RATE_PER_MINUTE=12
# Max DeepSeek calls per session-token per day.
DYADLINK_SESSION_CALLS_PER_DAY=300
# Global daily token budget across ALL visitors (protects the API key).
# Set to 0 to disable the global cap.
DYADLINK_DAILY_TOKEN_BUDGET=500000
# Minimum seconds between two DeepSeek calls from the same session.
DYADLINK_MIN_INTERVAL_SECONDS=1.5

# Optional: set to 1 to include sanitised provider error details in logs.
DYADLINK_DEBUG_API_ERRORS=
